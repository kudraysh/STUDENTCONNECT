generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudyGroup {
  id          String @id @default(cuid())
  name        String @unique
  course      Int
  institution String @default("МИЭТ, колледж")
  users       User[]
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  firstName          String
  lastName           String
  nickname           String?             @unique
  phone              String?
  bio                String              @default("")
  avatar             String?
  course             Int                 @default(1)
  lastVerificationAt DateTime?
  sessions           Session[]
  verificationTokens EmailVerification[]
  events             Event[]
  eventApplications  EventApplication[]
  eventMemberships   EventMember[]
  feedTutorialCount  Int                 @default(0)
  feedChoices        FeedChoice[]        @relation("FeedActor")
  feedReceived       FeedChoice[]        @relation("FeedTarget")
  notifications      Notification[]
  eventNotices       EventNotice[]
  conversationsA     Conversation[]      @relation("ConversationA")
  conversationsB     Conversation[]      @relation("ConversationB")
  messages           ChatMessage[]
  phoneOwned         PhoneAccess[]       @relation("PhoneOwner")
  phoneRequested     PhoneAccess[]       @relation("PhoneRequester")
  feedbackReports    FeedbackReport[]
  reports            InterestReport[]
  emailVerifiedAt    DateTime?
  createdAt          DateTime            @default(now())
  groupId            String
  group              StudyGroup          @relation(fields: [groupId], references: [id])
  interests          UserInterest[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  interests Interest[]
  events    Event[]
}

model Interest {
  id             String           @id @default(cuid())
  name           String
  normalizedName String           @unique
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  users          UserInterest[]
  reports        InterestReport[]
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model InterestReport {
  id         String   @id @default(cuid())
  userId     String
  interestId String
  reason     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
}

model Event {
  closedAt     DateTime?
  id           String             @id @default(cuid())
  title        String
  description  String
  place        String
  startsAt     DateTime
  capacity     Int
  createdAt    DateTime           @default(now())
  organizerId  String
  organizer    User               @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  categoryId   String
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  applications EventApplication[]
  members      EventMember[]
  notices      EventNotice[]

  @@index([startsAt, id])
  @@index([organizerId])
  @@index([categoryId, startsAt])
}

model EventApplication {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
}

model EventMember {
  eventId    String
  userId     String
  state      String   @default("ACTIVE")
  joinCount  Int      @default(1)
  leaveCount Int      @default(0)
  kickReason String?
  joinedAt   DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([eventId, state])
  @@index([userId, state])
}

model EventNotice {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  kind      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Conversation {
  id            String        @id @default(cuid())
  userAId       String
  userBId       String
  userA         User          @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User          @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  readA         Int           @default(0)
  readB         Int           @default(0)
  createdAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId String
  senderId       String
  clientId       String
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, id])
}

model PhoneAccess {
  id          String   @id @default(cuid())
  ownerId     String
  requesterId String
  status      String   @default("PENDING")
  version     Int      @default(1)
  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("PhoneOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  requester   User     @relation("PhoneRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([ownerId, requesterId])
  @@index([ownerId, status])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  kind           String
  message        String
  conversationId String?
  profileId      String?
  messageId      Int?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt, id])
  @@index([userId, conversationId, messageId])
}

model FeedChoice {
  actorId   String
  targetId  String
  decision  String
  hiddenUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actor User @relation("FeedActor", fields: [actorId], references: [id], onDelete: Cascade)
  target User @relation("FeedTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([actorId, targetId])
  @@index([actorId, decision, hiddenUntil])
}

model FeedbackReport {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  area        String
  title       String
  steps       String
  expected    String
  actual      String
  page        String
  environment String   @default("")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, createdAt, id])
  @@index([status, createdAt])
}
