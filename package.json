{
  "name": "studentconnect",
  "private": true,
  "version": "0.4.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "6.19.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.20.0"
  }
}
